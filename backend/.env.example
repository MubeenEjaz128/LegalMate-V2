# =================================================================
# LegalMate Backend - Environment Variables Template (.env.example)
# =================================================================
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit real .env files with secrets into git.

# -----------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------
# Port for the Node.js Express server
PORT=9000
# Node environment mode: 'development' or 'production'
NODE_ENV=development

# -----------------------------------------------------------------
# 2. Database (MongoDB)
# -----------------------------------------------------------------
# Local MongoDB connection:
# MONGODB_URI=mongodb://localhost:27017/legalmate
# Production (MongoDB Atlas connection string with username and password):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/legalmate?retryWrites=true&w=majority

# -----------------------------------------------------------------
# 3. Security & JWT Authentication
# -----------------------------------------------------------------
# Strong secret used to sign JWT auth tokens.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------
# 4. CORS & Cross-Origin Allowed Origins
# -----------------------------------------------------------------
# URL of the frontend application (for CORS and email redirect links)
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed origins (e.g., your Vercel deployment URL)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------
# 5. Email Notification Services
# -----------------------------------------------------------------
# Option A: Nodemailer (SMTP - Gmail or standard SMTP)
EMAIL_USER=legalmate.services@example.com
EMAIL_PASS=your_gmail_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
FROM_EMAIL="LegalMate Services" <no-reply@legalmate.me>

# Option B: Brevo / Sendinblue (HTTP-based API - Reliable when hosting providers block SMTP ports)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Option C: SendGrid (Optional)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# -----------------------------------------------------------------
# 6. AI Models & Legal Consultation LLMs
# -----------------------------------------------------------------
# Primary AI Provider: Perplexity API (Sonar model for legal citation & search)
PERPLEXITY_API_KEY=pplx-your_perplexity_api_key_here

# Secondary / Fallback AI Provider: Google Gemini API (Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Tertiary Local Fallback: Ollama (Optional for local offline LLM testing)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# AI Toggles
INTEGRATE_AI=true
AI_SERVICE_URL=http://127.0.0.1:5001

# -----------------------------------------------------------------
# 7. Rate Limiting
# -----------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AI_DAILY_LIMIT=30
AI_MINUTE_LIMIT=5

# -----------------------------------------------------------------
# 8. Admin Reset Credentials (Used by reset-admin.js)
# -----------------------------------------------------------------
ADMIN_EMAIL=admin@legalmate.local
ADMIN_PASSWORD=ChangeMeInProduction123!
