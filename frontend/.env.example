# =================================================================
# LegalMate Frontend - Environment Variables Template (.env.example)
# =================================================================
# Copy this file to .env or .env.production depending on environment.
# In Vite, only variables prefixed with VITE_ are exposed to the client.

# -----------------------------------------------------------------
# 1. API Base URL
# -----------------------------------------------------------------
# Local Development:
# VITE_API_URL=http://localhost:9000/api

# Production (e.g., Render backend):
# Note: The frontend extracts the socket root URL automatically by trimming '/api'.
VITE_API_URL=https://your-legalmate-backend.onrender.com/api
