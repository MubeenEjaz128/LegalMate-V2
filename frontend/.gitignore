# ==========================================
# LegalMate Frontend Git Ignore
# ==========================================

# Dependencies
node_modules/

# Production Build
dist/
dist-ssr/

# Environment Variables & Secrets
.env
.env.local
.env.production
.env.development.local
.env.test.local
.env.production.local
!.env.example

# SSL Certificates & Private Keys
certs/*.pem
certs/*.key
certs/localhost-key.pem
certs/localhost.pem
certs/key.pem
certs/cert.pem
!certs/.gitkeep

# Audit & Temp Files
audit-frontend.json
*.tmp
*.bak

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
